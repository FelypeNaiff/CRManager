# Never place real credentials in this example file.
# Runtime (Vercel/serverless): Supabase Transaction Pooler, port 6543.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Prisma CLI/migrations: prefer Direct Connection; Session Pooler is the IPv4 alternative.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# Administrative scripts must use an explicit target and never fall back to DATABASE_URL.
ADMIN_DATABASE_URL="postgresql://USER:PASSWORD@ADMIN_HOST:5432/postgres?sslmode=require"
ADMIN_DATABASE_ENVIRONMENT="local-or-staging"
ADMIN_DATABASE_CONFIRMATION="SET_ONLY_WHEN_EXPLICITLY_AUTHORIZING_A_DESTRUCTIVE_OPERATION"
ALLOW_PRODUCTION_ADMIN_DATABASE="false"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="SUPABASE_ANON_KEY"
SUPABASE_SECRET_KEY="SUPABASE_SECRET_KEY"
GEMINI_API_KEY="GEMINI_API_KEY"
NEEX_PROFILE_SESSION_SECRET=

# Temporary development/bootstrap utility only (scripts/create-master-user.ts)
NEEX_BOOTSTRAP_EMAIL="developer@example.com"
NEEX_BOOTSTRAP_PASSWORD="SET_A_LOCAL_DEVELOPMENT_PASSWORD"
NEEX_BOOTSTRAP_PIN="SET_A_LOCAL_DEVELOPMENT_PIN"
NEEX_BOOTSTRAP_NAME="Administrador de Desenvolvimento"
NEEX_BOOTSTRAP_USERNAME="developer"
